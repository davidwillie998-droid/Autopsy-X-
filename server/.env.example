# Copy this file to .env (or export these as real environment variables)
# and never commit the real .env — it's already in .gitignore.

ANTHROPIC_API_KEY=
BRIDGE_KEY=
PORT=8787
ANTHROPIC_MODEL=claude-sonnet-5

# Powers GET /macro/snapshot, which feeds AUTOPSY X's macro/breadth
# engines (see mt5/README.md). Free at alphavantage.co/support/#api-key —
# the free tier is 25 requests/day, which server.js's own caching keeps
# well under even with frequent polling. Leave blank to disable the
# endpoint (it responds with a clear error instead of failing silently).
ALPHA_VANTAGE_API_KEY=
# Comma-separated tickers for the news-sentiment leg — no spaces.
ALPHA_VANTAGE_NEWS_TICKERS=QQQ

# Leave unset (defaults to 0.0.0.0) when deploying to a host like Render —
# it needs to accept connections from outside the container. Set this to
# 127.0.0.1 only if you're running purely on your own machine and want to
# guarantee nothing but localhost can ever reach it.
HOST=
